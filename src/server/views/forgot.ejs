<%
const content = `
  ${ error ? '<div class="error">' + error + '</div>' : '' }
  ${ success ? '<div class="success">' + success + '</div>' : '' }
  ${ success ? '' : `
  <p style="color:#666;margin-bottom:1rem;">Enter your account email and we'll send you a link to reset your password.</p>
  <form method="POST" action="/auth/forgot">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autofocus>
    <button type="submit" style="width:100%;">Send reset link</button>
  </form>
  ` }
  <p class="alt-link"><a href="/web/login">Back to sign in</a></p>
`;
%>
<%- include('_auth-layout', { title: 'Forgot password - Mob CRM', subtitle: 'Reset your password', content }) %>
