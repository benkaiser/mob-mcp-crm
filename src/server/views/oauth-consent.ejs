<%
const redirectLabel = String(redirectUri);
const clientLabel = String(clientId);
const content = `
  <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:0.9rem;margin-bottom:1rem;font-size:0.95rem;">
    <strong>Confirm MCP client access</strong>
    <p style="margin:0.5rem 0 0;">Mob will authorize this client and redirect your browser/app to:</p>
    <code style="display:block;margin-top:0.5rem;font-size:0.8rem;word-break:break-all;">${redirectLabel.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code>
  </div>
  <dl style="font-size:0.9rem;margin-bottom:1rem;">
    <dt style="font-weight:600;color:#555;">Client ID</dt>
    <dd style="word-break:break-all;margin:0 0 0.7rem;">${clientLabel.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</dd>
  </dl>
  <form method="POST" action="${authorizeUrl}">
    <input type="hidden" name="confirm_authorize" value="1">
    <input type="hidden" name="client_id" value="${clientLabel.replace(/&/g, '&amp;').replace(/"/g, '&quot;')}">
    <input type="hidden" name="code_challenge" value="${String(codeChallenge).replace(/&/g, '&amp;').replace(/"/g, '&quot;')}">
    <input type="hidden" name="code_challenge_method" value="${String(codeChallengeMethod).replace(/&/g, '&amp;').replace(/"/g, '&quot;')}">
    <input type="hidden" name="redirect_uri" value="${redirectLabel.replace(/&/g, '&amp;').replace(/"/g, '&quot;')}">
    ${state ? `<input type="hidden" name="state" value="${String(state).replace(/&/g, '&amp;').replace(/"/g, '&quot;')}">` : ''}
    <button type="submit" style="width:100%;">Authorize and continue</button>
  </form>
  <p class="alt-link"><a href="/app/">Cancel</a></p>
`;
%>
<%- include('_auth-layout', { title: 'Authorize MCP Client — Mob CRM', subtitle: 'Confirm client access', content }) %>
